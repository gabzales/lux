<%
const pageTitle = 'Beli ' + product.name;
const _items = product.items || [];
const _plats = product.platforms || [];
const _rating = (typeof ratingInfo !== 'undefined' && ratingInfo) ? ratingInfo : { avg: 0, count: 0 };
const _firstAvail = _items.findIndex(i => (i.stok || 0) > 0);
const _sel = _firstAvail >= 0 ? _firstAvail : 0;
const _priceOf = it => (it ? ((isReseller && it.reseller_price) ? it.reseller_price : it.p) : 0);
const _platLabel = { ios: 'IOS', android: 'ANDROID', pc: 'PC' };
const _hasStock = (typeof product.stockCount === 'number' ? product.stockCount : 0) > 0; // server hanya kirim jumlah stok, bukan isi key
const _durLabel = (l, item) => (item && item.durLabel) ? item.durLabel : l; // 'N Hari' / 'N Jam' dihitung server (dur.displayLabel)
const _jsSafe = v => JSON.stringify(v).replace(/</g, '\\u003c');
%>

<style>
    .buy-label { display:flex; align-items:center; gap:8px; font-size:12px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--text-1); margin-bottom:12px; }
    .buy-label .n { width:20px; height:20px; border-radius:6px; background:var(--royal); color:var(--on-accent); display:inline-flex; align-items:center; justify-content:center; font-size:11px; }
    .buy-box { background:var(--bg-card); border:1px solid var(--border); border-radius:16px; padding:16px; }
    .buy-cap { font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:var(--text-2); margin-bottom:10px; }
    .buy-hero { aspect-ratio:4/3; }
    .plat-pill { border:1px solid var(--border-md); color:var(--text-1); font-size:10px; font-weight:700; letter-spacing:.05em; padding:2px 10px; border-radius:999px; line-height:1.5; }
    .buy-input { width:100%; padding:12px 14px; border-radius:12px; font-size:14px; color:#fff; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); outline:none; transition:border-color .15s; }
    .buy-input::placeholder { color:rgba(255,255,255,.28); }
    .buy-input:focus { border-color:rgba(34,211,238,.7); }
    .buy-field label { display:block; font-size:12px; font-weight:700; color:var(--text-1); margin-bottom:6px; }
    .buy-field label i { color:#f87171; font-style:normal; }
    .pkg-option-label { display:block; cursor:pointer; }
    .pkg-option-label input[type=radio] { display:none; }
    .pkg-card { position:relative; background:rgba(255,255,255,.03); border:1px solid var(--border); border-radius:12px; padding:12px 14px; transition:border-color .15s, background .15s; }
    .pkg-card:hover { border-color:var(--border-md); }
    .pkg-option-label input[type=radio]:checked + .pkg-card { border-color:var(--blue); background:rgba(6,182,212,.14); }
    .pkg-check { display:none; position:absolute; top:9px; right:9px; width:18px; height:18px; border-radius:50%; border:1.5px solid var(--blue); color:var(--blue); font-size:11px; font-weight:800; align-items:center; justify-content:center; line-height:1; }
    .pkg-option-label input[type=radio]:checked + .pkg-card .pkg-check { display:flex; }
    .pkg-off { opacity:.5; cursor:not-allowed; }
    .rv-row { padding:14px 0; border-top:1px solid var(--border); }
    .rv-row:first-child { border-top:0; padding-top:4px; }
    .rv-avatar { width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,.1); color:#fff; font-weight:800; font-size:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .count-up { opacity:1; }
</style>

<%- include('../partials/nav', { active: 'products' }) %>

<div class="min-h-screen pt-20 pb-10 px-3 sm:px-6">
<div class="max-w-5xl mx-auto">
<div class="grid lg:grid-cols-[340px_minmax(0,1fr)] gap-4 items-start">

<!-- ═════ KIRI: info produk ═════ -->
<div class="lg:sticky lg:top-24 space-y-4">

    <div class="buy-box overflow-hidden fade-in-up" style="padding:0;">
        <div class="relative buy-hero" style="background:var(--bg-section);">
            <% if (product.image) { %><img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover" onerror="this.style.display='none'"><% } else { %><div class="w-full h-full flex items-center justify-center"><iconify-icon icon="solar:gamepad-bold" style="font-size:48px;color:var(--text-3);"></iconify-icon></div><% } %>
        </div>
        <div class="p-4">
            <h1 class="text-lg font-bold font-display leading-tight mb-2"><%= product.name %></h1>
            <% if (_plats.length) { %>
            <div class="flex gap-1.5 flex-wrap mb-2"><% _plats.forEach(p => { %><span class="plat-pill"><%= _platLabel[p] || String(p).toUpperCase() %></span><% }) %></div>
            <% } %>
            <div class="flex items-center gap-1.5 text-xs flex-wrap" style="color:var(--text-2);">
                <% if (_rating.count > 0) { %><span style="color:#fbbf24;">&#9733;</span><b style="color:#fff;"><%= Number(_rating.avg).toFixed(1) %></b><span>(<%= _rating.count %> ulasan)</span><span style="color:var(--text-3);">&bull;</span><% } %>
                <span><%= (product.sold || 0).toLocaleString('id-ID') %> Terjual</span>
            </div>
            <% if (product.installUrl) { %>
            <a href="<%= product.installUrl %>" target="_blank" rel="noopener noreferrer" class="mt-4 flex items-center justify-center gap-2 w-full py-2.5 rounded-xl text-sm font-semibold" style="border:1px solid var(--border-md);color:#fff;text-decoration:none;">
                <iconify-icon icon="mdi:open-in-new" style="font-size:15px;"></iconify-icon>Cara Pasang / Download
            </a>
            <% } %>
        </div>
    </div>

    <% if (product.description && product.description.trim()) { %>
    <div class="buy-box fade-in-up">
        <div class="buy-cap">Deskripsi Produk</div>
        <p class="text-sm leading-relaxed" style="color:var(--text-1);white-space:pre-line;"><%= product.description %></p>
    </div>
    <% } %>

    <div class="buy-box fade-in-up">
        <div class="buy-cap">Cara Pembelian</div>
        <ol class="text-sm space-y-1.5 list-decimal pl-5" style="color:var(--text-2);">
            <li>Pilih durasi produk</li>
            <li>Pilih metode pembayaran</li>
            <li>Isi nama dan nomor WhatsApp, lalu bayar sesuai total</li>
            <li>Tunggu konfirmasi admin, key tampil di halaman Cek Pesanan</li>
            <% if (product.installUrl) { %><li>Klik "Cara Pasang / Download" untuk mendapatkan link dan tutorial</li><% } %>
        </ol>
    </div>
</div>

<!-- ═════ KANAN: langkah beli ═════ -->
<div class="space-y-4 min-w-0">

    <!-- 1 DURASI -->
    <div class="buy-box fade-in-up">
        <div class="buy-label"><span class="n">1</span>Pilih Durasi</div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="pkg-grid">
            <% _items.forEach((item, idx) => { %>
            <% const itemStock = (item.stok || 0); const isOut = itemStock === 0; const displayPrice = _priceOf(item); %>
            <label class="pkg-option-label<%= isOut ? ' pkg-off' : '' %>">
                <input type="radio" name="pkg" value="<%= idx %>" data-l="<%= item.l %>" data-p="<%= displayPrice %>" data-s="<%= itemStock %>" onchange="selectPkg(this.dataset.l, Number(this.dataset.p), Number(this.dataset.s))" <%= idx === _sel && !isOut ? 'checked' : '' %> <%= isOut ? 'disabled' : '' %>>
                <div class="pkg-card">
                    <span class="pkg-check">&#10003;</span>
                    <div class="text-xs font-semibold mb-1" style="color:var(--text-2);"><%= _durLabel(item.l, item) %></div>
                    <div class="text-sm font-extrabold <%= isReseller && item.reseller_price ? 'text-yellow-400' : 'text-white' %>">Rp <%= displayPrice.toLocaleString('id-ID') %></div>
                    <% if (isReseller && item.reseller_price) { %><div class="text-[10px] line-through" style="color:var(--text-3);">Rp <%= item.p.toLocaleString('id-ID') %></div><% } %>
                    <% if (isOut) { %><div class="text-[10px] font-bold mt-0.5" style="color:#f87171;">Stok habis</div><% } %>
                </div>
            </label>
            <% }) %>
        </div>
    </div>

    <!-- 2 PEMBAYARAN -->
    <div class="buy-box fade-in-up">
        <div class="buy-label"><span class="n">2</span>Pilih Pembayaran</div>
        <div class="rounded-xl" style="border:1px solid var(--border);background:rgba(255,255,255,.02);">
            <div class="flex items-center gap-3 p-3">
                <span class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(6,182,212,.14);"><iconify-icon icon="mdi:qrcode-scan" style="font-size:20px;color:var(--blue);"></iconify-icon></span>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-bold">QRIS (All Payment)</div>
                    <div class="text-[11px]" style="color:var(--text-2);">Gopay, OVO, Dana, LinkAja, BCA, dll</div>
                </div>
                <iconify-icon icon="mdi:chevron-up" style="font-size:20px;color:var(--text-2);flex-shrink:0;"></iconify-icon>
            </div>
            <div class="px-3 pb-3">
                <div class="rounded-lg p-3 flex items-center justify-between gap-3" style="border:1.5px solid var(--blue);background:rgba(6,182,212,.10);">
                    <div class="min-w-0">
                        <div class="text-sm font-bold">QRIS &mdash; dikonfirmasi admin</div>
                        <div class="text-[11px]" style="color:var(--text-2);">Biaya Admin: <b style="color:#4ade80;">GRATIS</b></div>
                    </div>
                    <iconify-icon icon="mdi:check-circle-outline" style="font-size:20px;color:var(--blue);flex-shrink:0;"></iconify-icon>
                </div>
            </div>
        </div>
    </div>

    <!-- 3 DATA PEMBELI + RINGKASAN -->
    <div class="buy-box space-y-4 fade-in-up">
        <div class="buy-label" style="margin-bottom:0;"><span class="n">3</span>Data Pembeli</div>

        <div class="buy-field">
            <label for="customerName">Nama Pembeli <i>*</i></label>
            <input type="text" id="customerName" class="buy-input" placeholder="Masukkan nama (bebas)" maxlength="40" autocomplete="name" value="<%= user?.username || '' %>">
        </div>
        <div class="buy-field">
            <label for="waInput">Nomor WhatsApp <i>*</i></label>
            <input type="tel" id="waInput" class="buy-input" placeholder="08xxxxxxxxxx" maxlength="15" inputmode="tel" autocomplete="tel" value="<%= user?.wa || '' %>">
            <p class="text-[11px] mt-1.5" style="color:var(--text-3);">Nomor ini digunakan sebagai identitas pesanan Anda.</p>
        </div>

        <div class="rounded-xl p-3.5 space-y-3" style="background:rgba(255,255,255,.03);border:1px solid var(--border);">
            <div>
                <label for="voucherInput" class="flex items-center gap-1.5 text-xs font-bold mb-2" style="color:var(--text-1);"><iconify-icon icon="mdi:ticket-percent-outline" style="color:var(--blue);font-size:16px;"></iconify-icon>Kode Promo</label>
                <div class="flex gap-2">
                    <input type="text" id="voucherInput" placeholder="MASUKKAN KODE PROMO" class="buy-input uppercase font-mono" style="flex:1;min-width:0;" maxlength="30" oninput="this.value=this.value.toUpperCase(); clearVoucher()">
                    <button type="button" onclick="applyVoucher()" id="voucherBtn" class="px-4 rounded-xl text-xs font-bold flex-shrink-0" style="background:transparent;border:1px solid var(--border-md);color:var(--text-1);">Terapkan</button>
                </div>
                <div id="voucherStatus" class="mt-1.5 hidden"></div>
            </div>
            <div class="space-y-2 text-sm pt-1">
                <div class="flex justify-between" style="color:var(--text-2);"><span>Harga Produk</span><span class="font-bold text-white" id="basePriceShow">Rp <%= _priceOf(_items[_sel]).toLocaleString('id-ID') %></span></div>
                <div id="voucherRow" class="hidden justify-between" style="color:var(--text-2);"><span>Diskon</span><span class="font-bold" style="color:#4ade80;" id="discountShow">-</span></div>
                <div class="flex justify-between" style="color:var(--text-2);"><span>Biaya Admin</span><span class="font-bold" style="color:#4ade80;">Gratis</span></div>
            </div>
        </div>
        <span id="selectedLabel" class="hidden"><%= _items[_sel]?.l || '-' %></span>

        <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold tracking-wider" style="color:var(--text-1);">TOTAL BAYAR</span>
            <span class="text-2xl font-display font-black" style="color:var(--blue);" id="totalPrice">Rp <%= _priceOf(_items[_sel]).toLocaleString('id-ID') %></span>
        </div>

        <% if (_hasStock) { %>
        <button id="submitBtn" onclick="handleOrder()" class="w-full py-3.5 rounded-xl text-sm font-bold" style="background:var(--royal);color:var(--on-accent);">Beli Sekarang</button>
        <button type="button" onclick="addProductToCart()" class="w-full py-2.5 rounded-xl text-xs font-semibold" style="background:transparent;border:1px solid var(--border);color:var(--text-2);">Simpan ke Keranjang</button>
        <% } else { %>
        <button disabled class="w-full py-3.5 rounded-xl text-sm font-bold cursor-not-allowed" style="background:rgba(255,255,255,.05);color:var(--text-3);border:1px solid var(--border);">Stok Habis</button>
        <% } %>
    </div>

    <!-- ULASAN PEMBELI -->
    <div class="buy-box fade-in-up">
        <h2 class="text-base font-bold mb-1">Ulasan Pembeli</h2>
        <div class="text-xs mb-3" style="color:var(--text-2);">Rata-rata <span style="color:#fbbf24;">&#9733;</span> <b class="text-white" id="avgRatingDisplay"><%= _rating.count > 0 ? Number(_rating.avg).toFixed(1) : '—' %></b> dari <span id="reviewCountDisplay"><%= _rating.count %></span> ulasan</div>

        <div id="reviewsList">
            <div class="text-center py-6" style="color:var(--text-3);"><p class="text-xs">Memuat ulasan...</p></div>
        </div>

        <div class="h-px my-4" style="background:var(--border);"></div>

        <% if (hasPurchased) { %>
        <h3 class="text-xs font-bold text-white mb-3">Tulis Ulasan Kamu</h3>
        <div class="flex gap-1 mb-3">
            <% for(let i=1;i<=5;i++) { %>
                <button type="button" onclick="setRating(<%= i %>)" id="rstar-<%= i %>" class="text-2xl text-white/15 transition-colors hover:text-yellow-400" aria-label="Rating <%= i %>">&#9733;</button>
            <% } %>
        </div>
        <textarea id="reviewText" class="buy-input mb-2" style="resize:none;" rows="3" placeholder="Bagikan pengalaman kamu dengan produk ini..."></textarea>
        <button onclick="submitReview()" class="w-full py-2.5 rounded-xl text-xs font-bold" style="background:transparent;border:1px solid var(--border-md);color:var(--blue);">Kirim Ulasan</button>
        <% } else { %>
        <div class="text-center py-4 px-3 rounded-xl text-xs" style="background:rgba(255,255,255,.03);border:1px solid var(--border);color:var(--text-2);">
            Hanya pembeli produk ini yang bisa memberikan rating &amp; ulasan.
        </div>
        <% } %>
    </div>

</div><!-- /kanan -->
</div><!-- /grid -->
</div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/purchase-toast') %>
<%- include('../partials/chat-fab') %>

<!-- PAYMENT MODAL -->
<div id="paymentModal" class="inset-0 hidden" style="position:fixed!important;z-index:99999;top:0;left:0;right:0;bottom:0;">
    <div class="absolute inset-0 bg-black/85 backdrop-blur-sm" onclick="closePayment()"></div>
    <div class="absolute inset-0 flex flex-col justify-end pointer-events-none">
        <div class="pointer-events-auto rounded-t-2xl w-full"
             style="background:var(--bg-card);border-top:1px solid var(--border);max-height:95dvh;overflow-y:auto;padding-bottom:calc(20px + env(safe-area-inset-bottom));">
            <!-- top bar -->
            <div class="h-px w-full" style="background:var(--border-md);"></div>
            <!-- drag handle -->
            <div class="flex justify-center pt-3 pb-1"><div class="w-10 h-1 rounded-full bg-white/15"></div></div>
            <!-- header -->
            <div class="flex items-center justify-between px-5 py-3 border-b border-white/5">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <iconify-icon icon="mdi:qrcode-scan" class="text-cyan-400"></iconify-icon>
                    Pembayaran QRIS
                </h3>
                <button onclick="closePayment()" class="w-8 h-8 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white transition-colors">
                    <iconify-icon icon="mdi:close"></iconify-icon>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <!-- QR CODE -->
                <div class="flex flex-col items-center">
                    <div id="qrCodeWrap" class="flex items-center justify-center" style="min-height:80px;">
                        <iconify-icon icon="mdi:loading" class="text-4xl text-cyan-400 animate-spin"></iconify-icon>
                    </div>
                    <p class="text-[10px] text-zinc-500 mt-2">Scan dengan aplikasi mobile banking / e-wallet</p>
                </div>

                <!-- INFO BARIS -->
                <div class="grid grid-cols-2 gap-2">
                    <div class="rounded-xl p-3 text-center" style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07)">
                        <div class="text-[10px] text-zinc-500 mb-0.5">Kode Pesanan</div>
                        <div class="text-sm font-mono font-black text-cyan-400 tracking-wider" id="orderCodeShow">—</div>
                    </div>
                    <div class="rounded-xl p-3 text-center" style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07)">
                        <div class="text-[10px] text-zinc-500 mb-0.5">Total Bayar</div>
                        <div class="text-sm font-black text-emerald-400" id="payAmountShow">—</div>
                    </div>
                </div>

                <!-- TIMER -->
                <div id="timerWrap" class="hidden rounded-xl p-3 text-center" style="background:rgba(251,191,36,.06);border:1px solid rgba(251,191,36,.2)">
                    <div class="text-[10px] text-zinc-500 mb-0.5 flex items-center justify-center gap-1">
                        <iconify-icon icon="mdi:clock-outline" class="text-yellow-400 text-xs"></iconify-icon>
                        Batas Waktu Pembayaran
                    </div>
                    <div class="text-xl font-black font-bold text-yellow-400" id="timerDisplay">--:--</div>
                </div>

                <!-- STATUS -->
                <div id="payStatusRow" class="flex items-center justify-center gap-2 py-2">
                    <div class="w-2 h-2 rounded-full bg-yellow-400 "></div>
                    <span class="text-xs text-zinc-400">Menunggu pembayaran...</span>
                </div>

                <!-- TOMBOL KONFIRMASI MANUAL (static) -->
                <div id="staticNote" class="hidden text-center rounded-xl p-3" style="background:rgba(6,182,212,.07);border:1px solid rgba(6,182,212,.2)">
                    <p class="text-xs text-cyan-300">Setelah bayar, tunggu konfirmasi admin. Key akan tampil di halaman Cek Pesanan.<% if (settings.contact?.whatsapp || settings.contact?.telegram) { %> Kirim bukti bayar ke admin agar lebih cepat.<% } %></p>
                    <div class="flex gap-2 mt-2 justify-center">
                        <a id="waConfirmBtn" href="#" target="_blank"
                           class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-white"
                           style="background:rgba(34,197,94,.2);border:1px solid rgba(34,197,94,.35)">
                            <iconify-icon icon="mdi:whatsapp" class="text-green-400 text-sm"></iconify-icon> WhatsApp
                        </a>
                        <% if (settings.contact?.telegram) { %>
                        <a href="https://t.me/<%= settings.contact.telegram %>" target="_blank" rel="noopener"
                           class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-white"
                           style="background:rgba(34,158,217,.2);border:1px solid rgba(34,158,217,.4)">
                            <iconify-icon icon="mdi:telegram" class="text-cyan-400 text-sm"></iconify-icon> Telegram
                        </a>
                        <% } %>
                    </div>
                </div>

                <!-- CEK ULANG -->
                <button id="recheckBtn" onclick="recheckNow()" class="hidden w-full py-2.5 rounded-xl text-xs font-bold text-cyan-400 border border-cyan-500/25 bg-cyan-500/5 hover:bg-cyan-500/10 transition-all flex items-center justify-center gap-2">
                    <iconify-icon icon="mdi:refresh" class="text-sm"></iconify-icon> Cek Status Sekarang
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // SECURITY: escape HTML sebelum inject ke innerHTML — mencegah stored XSS
    // dari input user (nama, teks ulasan) yang dirender lewat template string.
    function escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    let selPkg = { label: <%- _jsSafe(_items[_sel]?.l || '') %>, price: <%= _priceOf(_items[_sel]) %>, stock: <%= _items[_sel]?.stok || 0 %> };
    let myRating = 0;
    let payInterval = null, payStopped = false, payTick = 0, payRef = null;
    // Saat tab kembali terlihat, cek status sekali (polling dijeda selama tab tersembunyi)
    document.addEventListener('visibilitychange', () => { if (!document.hidden && !payStopped && payRef) checkPay(payRef); });
    let currentRefId = null;
    let appliedVoucher = null;   // { code, discount, finalPrice }
    const PID   = '<%= product.id %>';
    const PNAME = '<%= product.name %>';

    function selectPkg(label, price, stock) {
        selPkg = { label, price, stock };
        document.getElementById('selectedLabel').textContent = label;
        clearVoucher();
        updateTotalDisplay(price);
    }

    function updateTotalDisplay(basePrice) {
        const baseEl   = document.getElementById('basePriceShow');
        const priceEl  = document.getElementById('totalPrice');
        const vRow     = document.getElementById('voucherRow');
        const discShow = document.getElementById('discountShow');
        if (baseEl) baseEl.textContent = 'Rp ' + basePrice.toLocaleString('id-ID');
        if (appliedVoucher) {
            const fp = Math.max(basePrice - appliedVoucher.discount, 0);
            priceEl.textContent = 'Rp ' + fp.toLocaleString('id-ID');
            if (vRow) { vRow.classList.remove('hidden'); vRow.classList.add('flex'); }
            if (discShow) discShow.textContent = '- Rp ' + appliedVoucher.discount.toLocaleString('id-ID');
        } else {
            priceEl.textContent = 'Rp ' + basePrice.toLocaleString('id-ID');
            if (vRow) { vRow.classList.add('hidden'); vRow.classList.remove('flex'); }
        }
    }

    async function applyVoucher() {
        const code = document.getElementById('voucherInput').value.trim();
        const statusEl = document.getElementById('voucherStatus');
        if (!code) { showToast('Masukkan kode promo', 'error'); return; }
        const btn = document.getElementById('voucherBtn');
        btn.disabled = true;
        btn.textContent = '...';
        try {
            const res = await fetch('/api/voucher/check', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code, price: selPkg.price })
            });
            const d = await res.json();
            if (d.valid) {
                appliedVoucher = { code: d.code, discount: d.discount, finalPrice: d.finalPrice };
                statusEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-emerald-400"><iconify-icon icon="mdi:check-circle" class="text-sm"></iconify-icon> Voucher <strong>${d.code}</strong> berhasil! Hemat Rp ${d.discount.toLocaleString('id-ID')}</div>`;
                statusEl.classList.remove('hidden');
                updateTotalDisplay(selPkg.price);
                showToast('Voucher berhasil dipakai!', 'success');
            } else {
                appliedVoucher = null;
                statusEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-red-400"><iconify-icon icon="mdi:alert-circle" class="text-sm"></iconify-icon> ${d.error}</div>`;
                statusEl.classList.remove('hidden');
                updateTotalDisplay(selPkg.price);
            }
        } catch(e) { showToast('Gagal memeriksa voucher', 'error'); }
        finally { btn.disabled = false; btn.textContent = 'Terapkan'; }
    }

    function clearVoucher() {
        appliedVoucher = null;
        const statusEl = document.getElementById('voucherStatus');
        statusEl.classList.add('hidden');
        updateTotalDisplay(selPkg.price);
    }

    function addProductToCart() {
        if (!selPkg.price) { showToast('Pilih paket dulu!','error'); return; }
        addToCart({ productId:PID, name:PNAME, duration:selPkg.label, price:selPkg.price, image:'<%= product.image||"" %>' });
    }

    async function handleOrder() {
        const name = document.getElementById('customerName').value.trim().replace(/\s+/g, ' ');
        const wa   = document.getElementById('waInput').value.trim().replace(/[\s\-()]/g,'');
        if (name.length < 2) { showToast('Masukkan nama pembeli!','error'); document.getElementById('customerName').focus(); return; }
        if (!wa)    { showToast('Masukkan nomor WhatsApp!','error'); document.getElementById('waInput').focus(); return; }
        if (!/^(\+62|62|0)[0-9]{8,13}$/.test(wa)) { showToast('Format WhatsApp tidak valid!','error'); document.getElementById('waInput').focus(); return; }
        if (!selPkg.label) { showToast('Pilih durasi dulu!','error'); return; }
        if (selPkg.stock === 0) { showToast('Stok durasi ini habis','error'); return; }

        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.textContent = 'Memproses...';

        try {
            const res  = await fetch('/create-order',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                productId: PID,
                duration: selPkg.label,
                customerName: name,
                wa,
                voucherCode: appliedVoucher ? appliedVoucher.code : undefined
            })});
            const data = await res.json();
            if (data.success) {
                showPaymentModal(data);
                showToast('Pesanan dibuat! Segera bayar via QRIS','success');
            } else if (data.redirect) {
                showToast('Silakan login terlebih dahulu','error');
                setTimeout(() => window.location.href = data.redirect, 1000);
            } else {
                showToast(data.message||'Gagal membuat pesanan','error');
            }
        } catch(e) { showToast('Koneksi error: ' + e.message,'error'); }
        finally {
            btn.disabled = false;
            btn.textContent = 'Beli Sekarang';
        }
    }

    function showPaymentModal(data) {
        const { qrString, orderCode, refId, isStatic, qrisStaticImage, totalPayment, expiredAt } = data;
        currentRefId = refId;

        // Tampilkan modal
        document.getElementById('paymentModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        // Isi info
        document.getElementById('orderCodeShow').textContent = orderCode || '—';
        document.getElementById('payAmountShow').textContent = totalPayment
            ? 'Rp ' + Number(totalPayment).toLocaleString('id-ID') : '—';

        // Reset status
        document.getElementById('payStatusRow').innerHTML =
            '<div class="w-2 h-2 rounded-full bg-yellow-400 "></div>' +
            '<span class="text-xs text-zinc-400">Menunggu pembayaran...</span>';

        // --- QR Code ---
        const wrap = document.getElementById('qrCodeWrap');

        if (isStatic && qrisStaticImage) {
            // QRIS static dari admin
            wrap.innerHTML = `
                <div style="background:#fff;padding:12px;border-radius:16px;display:inline-block;">
                    <img src="${qrisStaticImage}" style="display:block;width:210px;height:210px;object-fit:contain;border-radius:6px;"
                         onerror="this.style.display='none';this.parentNode.innerHTML='<p style=color:#666;font-size:11px;padding:20px>Gambar QRIS tidak ditemukan</p>'">
                </div>`;
            document.getElementById('staticNote').classList.remove('hidden');
            const waNum = '<%= settings.contact?.whatsapp || "" %>';
            const waBtn = document.getElementById('waConfirmBtn');
            if (waNum) waBtn.href = `https://wa.me/${waNum}?text=${encodeURIComponent('Konfirmasi pembayaran kode: ' + orderCode)}`;
            else waBtn.style.display = 'none';
        } else if (qrString) {
            // QRIS dari PakKasir API — render pakai img dari qrserver.com (putih bersih)
            wrap.innerHTML = `
                <div style="background:#fff;padding:12px;border-radius:16px;display:inline-block;">
                    <img id="qrImg"
                         src="https://api.qrserver.com/v1/create-qr-code/?size=210x210&color=000000&bgcolor=ffffff&qzone=1&data=${encodeURIComponent(qrString)}"
                         style="display:block;width:210px;height:210px;border-radius:4px;"
                         onerror="qrFallback('${encodeURIComponent(qrString)}')">
                </div>`;
            document.getElementById('recheckBtn').classList.remove('hidden');
        } else {
            wrap.innerHTML = `
                <div class="text-center py-4">
                    <iconify-icon icon="mdi:qrcode-remove" class="text-5xl text-zinc-700 block mb-2"></iconify-icon>
                    <p class="text-xs text-zinc-500">QRIS belum dikonfigurasi.<br>Hubungi admin.</p>
                </div>`;
        }

        // --- Timer countdown ---
        if (expiredAt) {
            document.getElementById('timerWrap').classList.remove('hidden');
            startTimer(expiredAt);
        }

        // --- Auto polling status ---
        if (refId && !isStatic) {
            // Polling bertahap (4s → 8s → 15s) & dijeda saat tab tersembunyi — dulu tetap tiap 4 detik.
            payStopped = false; payTick = 0; payRef = refId;
            const payLoop = () => {
                payTick++;
                const wait = payTick <= 8 ? 4000 : (payTick <= 20 ? 8000 : 15000);
                payInterval = setTimeout(async () => {
                    if (payStopped) return;
                    if (!document.hidden) await checkPay(refId);
                    if (!payStopped) payLoop();
                }, wait);
            };
            payLoop();
        }
    }

    // Fallback QR jika qrserver.com gagal
    window.qrFallback = function(encoded) {
        const wrap = document.getElementById('qrCodeWrap');
        wrap.innerHTML = `
            <div style="background:#fff;padding:12px;border-radius:16px;display:inline-block;">
                <img src="https://quickchart.io/qr?text=${encoded}&size=210&margin=1&ecLevel=M"
                     style="display:block;width:210px;height:210px;border-radius:4px;"
                     onerror="this.parentNode.parentNode.innerHTML='<p style=color:#999;font-size:11px;padding:16px>Gagal load QR. Cek koneksi internet.</p>'">
            </div>`;
    };

    let timerInterval = null;
    function startTimer(expiredAt) {
        const el = document.getElementById('timerDisplay');
        const end = new Date(expiredAt).getTime();
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = setInterval(() => {
            const diff = end - Date.now();
            if (diff <= 0) {
                clearInterval(timerInterval);
                el.textContent = '00:00';
                el.style.color = '#f87171';
                document.getElementById('payStatusRow').innerHTML =
                    '<iconify-icon icon="mdi:clock-alert" class="text-red-400"></iconify-icon>' +
                    '<span class="text-xs text-red-400">Waktu pembayaran habis</span>';
                return;
            }
            const m = Math.floor(diff / 60000);
            const s = Math.floor((diff % 60000) / 1000);
            el.textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
            // Warna merah kalau < 2 menit
            el.style.color = diff < 120000 ? '#f87171' : '#fbbf24';
        }, 1000);
    }

    async function checkPay(refId) {
        try {
            const r = await fetch(`/check-payment/${refId}`);
            const d = await r.json();
            if (d.success && d.status === 'done') {
                payStopped = true; clearTimeout(payInterval);
                clearInterval(timerInterval);
                if (d.outOfStock) {
                    document.getElementById('payStatusRow').innerHTML =
                        '<iconify-icon icon="mdi:clock-alert-outline" class="text-amber-400 text-xl"></iconify-icon>' +
                        '<span class="text-sm font-bold text-amber-400">Pembayaran diterima, stok sedang kosong</span>';
                    showToast('Pembayaran berhasil! Stok sedang kosong, admin akan segera proses pesananmu.','info');
                } else {
                    document.getElementById('payStatusRow').innerHTML =
                        '<iconify-icon icon="mdi:check-circle" class="text-emerald-400 text-xl"></iconify-icon>' +
                        '<span class="text-sm font-bold text-emerald-400">Pembayaran berhasil!</span>';
                    showToast('Pembayaran berhasil! Key sudah dikirim!','success');
                }
                setTimeout(() => { closePayment(); window.location.href = '/invoice?code=' + d.code; }, 1800);
            } else if (d.delivering) {
                const row = document.getElementById('payStatusRow');
                if (row) row.innerHTML = '<iconify-icon icon="mdi:loading" class="text-cyan-400 text-xl animate-spin"></iconify-icon><span class="text-sm font-bold text-cyan-400">Pembayaran diterima, menyiapkan key…</span>';
            } else if (d.status === 'expired') {
                payStopped = true; clearTimeout(payInterval);
                document.getElementById('payStatusRow').innerHTML =
                    '<iconify-icon icon="mdi:clock-alert" class="text-red-400"></iconify-icon>' +
                    '<span class="text-xs text-red-400">Pembayaran expired</span>';
            }
        } catch(e) {}
    }

    async function recheckNow() {
        if (!currentRefId) return;
        const btn = document.getElementById('recheckBtn');
        btn.disabled = true;
        btn.innerHTML = '<iconify-icon icon="mdi:loading" class="text-sm animate-spin"></iconify-icon> Mengecek...';
        await checkPay(currentRefId);
        setTimeout(() => {
            btn.disabled = false;
            btn.innerHTML = '<iconify-icon icon="mdi:refresh" class="text-sm"></iconify-icon> Cek Status Sekarang';
        }, 1000);
    }

    function closePayment() {
        payStopped = true; if (payInterval) { clearTimeout(payInterval); payInterval = null; }
        if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
        document.getElementById('paymentModal').classList.add('hidden');
        document.getElementById('timerWrap').classList.add('hidden');
        document.getElementById('staticNote').classList.add('hidden');
        document.getElementById('recheckBtn').classList.add('hidden');
        document.body.style.overflow = '';
    }

    function setRating(val) {
        myRating = val;
        for (let i=1;i<=5;i++) {
            const el = document.getElementById(`rstar-${i}`);
            if (el) el.style.color = i <= val ? '#fbbf24' : 'rgba(255,255,255,0.15)';
        }
    }

    async function submitReview() {
        if (!myRating) { showToast('Pilih rating bintang dulu!','error'); return; }
        const text = document.getElementById('reviewText').value.trim();
        if (!text) { showToast('Tulis ulasan terlebih dahulu!','error'); return; }
        try {
            const res = await fetch('/api/testimonials', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: PID, productName: PNAME, rating: myRating, text })
            });
            const data = await res.json();
            if (data.success) {
                showToast('Ulasan berhasil dikirim! ','success');
                document.getElementById('reviewText').value = '';
                setRating(0);
                loadReviews();
            } else {
                showToast(data.message || 'Gagal mengirim ulasan','error');
            }
        } catch(e) {
            showToast('Koneksi error','error');
        }
    }

    let allReviews = [];
    function renderReviews(limit) {
        const el = document.getElementById('reviewsList');
        if (!allReviews.length) {
            el.innerHTML = '<div class="text-center py-6 text-xs" style="color:var(--text-3);">Belum ada ulasan. Jadilah yang pertama setelah membeli.</div>';
            return;
        }
        const list = limit ? allReviews.slice(0, limit) : allReviews;
        el.innerHTML = list.map(r => {
            const date = r.date ? new Date(r.date).toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric', timeZone:'Asia/Jakarta' }) : '';
            const name = escapeHtml(r.name || r.username || 'Anonim');
            const rt = Math.max(0, Math.min(5, parseInt(r.rating) || 0));
            const stars = Array.from({length:5}, (_, i) => `<span style="color:${i < rt ? '#fbbf24' : 'rgba(255,255,255,.15)'};">&#9733;</span>`).join('');
            return `<div class="rv-row">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="rv-avatar">${name.charAt(0).toUpperCase()}</div>
                        <div class="min-w-0"><div class="text-sm font-bold text-white truncate">${name}</div><div class="text-[11px]" style="color:var(--text-3);">${date}</div></div>
                    </div>
                    <div class="text-sm flex-shrink-0" style="letter-spacing:1px;">${stars}</div>
                </div>
                ${r.text ? `<p class="text-sm mt-2" style="color:var(--text-1);">${escapeHtml(r.text)}</p>` : ''}
            </div>`;
        }).join('') + ((limit && allReviews.length > limit) ? `<button onclick="renderReviews()" class="w-full py-2.5 mt-1 rounded-xl text-xs font-semibold" style="border:1px solid var(--border);color:var(--text-2);background:transparent;">Lihat semua ${allReviews.length} ulasan</button>` : '');
    }
    async function loadReviews() {
        const el = document.getElementById('reviewsList');
        try {
            const res = await fetch(`/api/testimonials?product=${encodeURIComponent(PID)}`);
            allReviews = await res.json();
            if (!Array.isArray(allReviews)) allReviews = [];
            const total = allReviews.length;
            document.getElementById('avgRatingDisplay').textContent = total ? (allReviews.reduce((s, r) => s + r.rating, 0) / total).toFixed(1) : '—';
            document.getElementById('reviewCountDisplay').textContent = total;
            renderReviews(8);
        } catch (e) {
            el.innerHTML = '<div class="text-center py-6 text-xs" style="color:var(--text-3);">Gagal memuat ulasan</div>';
        }
    }

    document.addEventListener('DOMContentLoaded', loadReviews);
</script>
