# ══════════════════════════════════════════════════════════
#  LUXZCO — Environment Variables (Production)
#  Copy file ini ke .env dan isi semua nilainya
# ══════════════════════════════════════════════════════════

# ─── SERVER ───────────────────────────────────────────────
PORT=3000
# ⚠️ Untuk .env LOKAL: hapus/komentari NODE_ENV dan VERCEL di bawah.
#    VERCEL=1 membuat server TIDAK listen di port (mode serverless).
#    Dua baris ini hanya untuk environment Vercel (sudah diset otomatis oleh vercel.json).
# NODE_ENV=production
# VERCEL=1

# ─── SESSION (WAJIB — generate random string panjang) ────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=GANTI_STRING_RANDOM_64_KARAKTER_DI_SINI

# ─── SUPABASE DATABASE (WAJIB) ───────────────────────────
# Dapat dari: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# PENTING: pakai SERVICE_ROLE key (bukan anon key).
# Server butuh full read/write ke keyvalue_store, dan RLS sekarang
# memblokir akses anon sepenuhnya. Service role key BYPASS RLS —
# JANGAN PERNAH expose key ini ke browser/client-side code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxx

# Optional — untuk auto-create tabel Supabase jika belum ada
SUPABASE_DB_PASSWORD=password_database_supabase_kamu

# ─── ADMIN AWAL (opsional, hanya dipakai saat pertama kali initDB jalan) ──
# !! PENTING !! Login admin membandingkan dengan hash di SUPABASE, bukan dengan env.
# Env ini cuma dipakai SEKALI (saat settings di Supabase masih kosong) atau saat
# FORCE_RESET_ADMIN=true. Kalau app sudah pernah jalan, mengubah env ini TIDAK
# mengubah password. Cara reset yang pasti:  node reset-admin.js <user> "<password>"
# Kalau tidak diisi, password admin di-generate random & di-print SEKALI ke log.
# Di .env, kutip value yang mengandung # → INITIAL_ADMIN_PASSWORD="abc#123"
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=
# FORCE_RESET_ADMIN=true   # sementara; HAPUS lagi setelah berhasil login

# ─── Hanya untuk menjalankan seed-settings.js secara lokal ───
# JANGAN diisi di env Vercel — ini cuma dipakai sekali dari lokal.
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_PASSWORD=

# ─── CLOUDFLARE TURNSTILE (SANGAT DISARANKAN — anti brute-force login user & admin) ────
# Daftar gratis di: https://dash.cloudflare.com → Turnstile
# Aktif otomatis saat kedua key ini diisi. Kosongkan = Turnstile dimatikan.
# TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxx
# TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxx

# ─── PAKASIR QRIS (isi setelah daftar di pakasir.com) ────
# Setting ini JUGA bisa diisi dari Admin Panel → Settings → PakKasir
# Tapi lebih aman disimpan di env var
# PAKASIR_API_KEY=your_api_key_here
# PAKASIR_PROJECT=your_project_name_here

# ──────────────────────────────────────────────────────────
#  CATATAN PENTING:
#  - JANGAN set ADMIN_USERNAME / ADMIN_PASSWORD hardcoded di kode manapun
#  - Setelah set env di Vercel, jalankan seed-settings.js dari lokal
#    (dengan SEED_ADMIN_USERNAME / SEED_ADMIN_PASSWORD di .env lokal)
#    untuk push credentials ke Supabase
# ──────────────────────────────────────────────────────────

# ─── PEMBAYARAN: GENSPAY (QRIS otomatis, konfirmasi lewat webhook) ──────────
# Aktifkan di Admin → Pengaturan → Pengaturan QRIS → GensPay.
# Kredensial HANYA lewat environment (tidak disimpan di database, tidak tampil di halaman).
# GENSPAY_API_KEY=
# GENSPAY_BASE_URL=https://genspay.my.id/api/v1
# URL publik toko (dipakai untuk callback webhook GensPay → /webhook/genspay):
# APP_URL=https://domain-toko-kamu.vercel.app

# ─── AUTO-RESTOCK (provider dipilih per produk: Admin → Produk → Edit → Auto-Restock) ──
# Stok lokal dipakai dulu; kalau habis, key diambil dari provider saat pembayaran lunas.
# Kredensial HANYA di environment (jangan di-commit, jangan ditempel di file contoh / chat).
#
# Drip Store (dripclientstore.shop):
# DRIPSTORE_API_TOKEN=
# DRIPSTORE_API_URL=https://dripclientstore.shop/api/v1
# ⚠ Drip Store memakai Cloudflare + allowlist IP. Vercel TIDAK punya IP keluar tetap → minta toko
#   mematikan allowlist untuk token ini, atau lewatkan lewat proxy/VPS ber-IP tetap.
#
# Ghostseller:
# GHOSTSELLER_API_KEY=gs_partner_xxxxxxxxxxxxxxxx
# GHOSTSELLER_API_URL=https://ghostseller.my.id
